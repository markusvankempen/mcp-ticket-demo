{
  "name": "mcp-ticket-demo",
  "version": "1.0.0",
  "description": "Demo MCP server for ticket workflows — local stdio and remote HTTP.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "mcp-ticket-demo": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "stdio": "MCP_MODE=stdio node src/index.js",
    "http": "MCP_MODE=http PORT=8787 node src/index.js",
    "test:smoke": "MCP_MODE=http PORT=8799 node src/smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  }
}
