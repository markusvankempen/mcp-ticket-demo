# Copy to server/.env if you want — the process also reads the real environment.
MCP_MODE=http
PORT=8787

# Admin page login. Also an admin-scoped MCP credential. Change before a public deploy.
ADMIN_USER=demo
ADMIN_PASSWORD=demo

# What needs a credential: off | write | all
#   off    nothing — the boring laptop default
#   write  create_ticket, add_comment, lookup_customer
#   all    every tool call (describe_server stays open)
AUTH_MODE=off

# Register one API key at boot, for deployments that provision credentials elsewhere.
# Scopes: read, write, pii, admin. write implies read; admin implies all.
# API_KEY=mcpk_boot_replace_me
# API_KEY_SCOPES=read,write

# Extra logins, presented as HTTP Basic. "user:password:scopes" per comma-separated group.
# MCP_USERS=alice:secret:read,write

# Rate limit, per caller, fixed window.
RATE_LIMIT=60
RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_ENABLED=0

# stdio only: the credential this process presents to itself, since stdio has no headers.
# MCP_API_KEY=mcpk_...
# MCP_USERNAME=alice
# MCP_PASSWORD=secret

# Legacy single bearer token, still accepted. Superseded by API keys.
DEMO_TOKEN=demo-token

# Legacy switch — same as AUTH_MODE=write.
WRITE_TOOLS_LOCKED=0

# Optional. When set, write tools also require header x-tenant-id.
# TENANT_ID=toronto-summit
