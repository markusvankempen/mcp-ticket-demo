{
  "name": "lf-mcp-summit-demo",
  "displayName": "MCP Ticket Demo — Server, Tools & Auth",
  "description": "Run a full MCP server with 10 tools, auth modes, API keys, rate limiting, per-tool gates, and live observability. One-click setup for VS Code, GitHub Copilot, Bob, Cursor, and Windsurf.",
  "version": "1.5.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-client",
    "mcp-demo",
    "mcp-tutorial",
    "mcp-tools",
    "mcp-stdio",
    "mcp-http",
    "mcp-authentication",
    "ai-tools",
    "ai-agent",
    "llm",
    "llm-tools",
    "agent",
    "agentic",
    "tool-calling",
    "function-calling",
    "copilot",
    "github-copilot",
    "bob",
    "cursor",
    "windsurf",
    "cline",
    "vscode",
    "vscode-extension",
    "stdio",
    "streamable-http",
    "sse",
    "podman",
    "docker",
    "code-engine",
    "ibm",
    "ibm-cloud",
    "linux-foundation",
    "mcp-dev-summit",
    "toronto",
    "demo",
    "tutorial",
    "example",
    "diagnostics",
    "tickets",
    "helpdesk",
    "ticketing-system",
    "authentication",
    "api-key",
    "rate-limiting",
    "observability",
    "nodejs",
    "node"
  ],
  "icon": "media/icon.png",
  "publisher": "markusvankempen",
  "repository": {
    "type": "git",
    "url": "https://github.com/markusvankempen/mcp-ticket-demo.git"
  },
  "homepage": "https://github.com/markusvankempen/mcp-ticket-demo#readme",
  "bugs": {
    "url": "https://github.com/markusvankempen/mcp-ticket-demo/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["AI", "Chat", "Education", "Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "package": "vsce package --no-dependencies --allow-star-activation"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "summitMcp",
          "title": "LF MCP Demo",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "summitMcp": [
        {
          "id": "summitMcp.setup",
          "name": "Setup & Diagnostics",
          "type": "webview"
        },
        {
          "id": "summitMcp.resources",
          "name": "Resources",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "summitMcp.discover",
        "title": "LF MCP Demo: Discover mcp.json"
      },
      {
        "command": "summitMcp.connectLocal",
        "title": "LF MCP Demo: Connect native stdio"
      },
      {
        "command": "summitMcp.connectRemote",
        "title": "LF MCP Demo: Connect remote Code Engine"
      },
      {
        "command": "summitMcp.connectPodmanStdio",
        "title": "LF MCP Demo: Connect container stdio (Podman / Docker)"
      },
      {
        "command": "summitMcp.connectPodmanHttp",
        "title": "LF MCP Demo: Connect container HTTP (Podman / Docker)"
      },
      {
        "command": "summitMcp.podmanStart",
        "title": "LF MCP Demo: Build & start local container (Podman / Docker)"
      },
      {
        "command": "summitMcp.podmanStop",
        "title": "LF MCP Demo: Stop local container"
      },
      {
        "command": "summitMcp.diagnose",
        "title": "LF MCP Demo: Diagnose"
      },
      {
        "command": "summitMcp.fillChat",
        "title": "LF MCP Demo: Send prompt to chat"
      },
      {
        "command": "summitMcp.chatSearch",
        "title": "LF MCP Demo: Chat — search open tickets"
      },
      {
        "command": "summitMcp.saveSettings",
        "title": "LF MCP Demo: Save settings"
      },
      {
        "command": "summitMcp.openHealth",
        "title": "LF MCP Demo: Open /health"
      },
      {
        "command": "summitMcp.openTest",
        "title": "LF MCP Demo: Open /test"
      },
      {
        "command": "summitMcp.openAdmin",
        "title": "LF MCP Demo: Open /admin"
      },
      {
        "command": "summitMcp.openTools",
        "title": "LF MCP Demo: Open /tools"
      },
      {
        "command": "summitMcp.openHelp",
        "title": "LF MCP Demo: Open /help"
      },
      {
        "command": "summitMcp.openPanel",
        "title": "LF MCP Demo: Open diagnostics panel",
        "icon": {
          "light": "media/icons/light/diagnose.svg",
          "dark": "media/icons/dark/diagnose.svg"
        }
      },
      {
        "command": "summitMcp.startLocalHttp",
        "title": "LF MCP Demo: Start native HTTP server"
      },
      {
        "command": "summitMcp.showMenu",
        "title": "LF MCP Demo: Show quick menu"
      },
      {
        "command": "summitMcp.openConfig",
        "title": "LF MCP Demo: Open mcp.json"
      },
      {
        "command": "summitMcp.installServer",
        "title": "LF MCP Demo: Install bundled server"
      },
      {
        "command": "summitMcp.updateServer",
        "title": "LF MCP Demo: Update server from npm"
      },
      {
        "command": "summitMcp.refreshTree",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "summitMcp.registerIde",
        "title": "LF MCP Demo: Register server with all IDEs"
      },
      {
        "command": "summitMcp.runMcpCrud",
        "title": "LF MCP Demo: Run MCP CRUD test"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "summitMcp.refreshTree",
          "when": "view == summitMcp.resources",
          "group": "navigation"
        },
        {
          "command": "summitMcp.openPanel",
          "when": "view == summitMcp.setup || view == summitMcp.resources",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MCP Platform Demo",
      "properties": {
        "summitMcp.probeTarget": {
          "type": "string",
          "enum": ["auto", "native-http", "podman", "remote"],
          "default": "auto",
          "description": "Which HTTP surface Diagnose and /health open. auto uses the Code Engine URL when set."
        },
        "summitMcp.remoteUrl": {
          "type": "string",
          "default": "",
          "description": "Public Code Engine URL, no trailing slash."
        },
        "summitMcp.localHttpUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Local native HTTP server for /health /test /admin."
        },
        "summitMcp.podmanImage": {
          "type": "string",
          "default": "mcp-ticket-demo:local",
          "description": "Local Podman image name built from mcp-ticket-demo/Dockerfile."
        },
        "summitMcp.podmanContainer": {
          "type": "string",
          "default": "mcp-ticket-demo",
          "description": "Local Podman container name."
        },
        "summitMcp.podmanPort": {
          "type": "number",
          "default": 8787,
          "description": "Host port mapped to container 8080."
        },
        "summitMcp.adminUser": {
          "type": "string",
          "default": "demo",
          "description": "Admin username for /admin."
        },
        "summitMcp.adminPassword": {
          "type": "string",
          "default": "demo",
          "description": "Admin password for /admin. Do not use this default in production."
        },
        "summitMcp.demoToken": {
          "type": "string",
          "default": "demo-token",
          "description": "Legacy single bearer token, still accepted by the server. Prefer an API key."
        },
        "summitMcp.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "API key to present when calling tools. Issue one on `/admin` → API keys. Sent as `Authorization: Bearer <key>` over HTTP, and as `MCP_API_KEY` to a stdio or Podman server."
        },
        "summitMcp.authMode": {
          "type": "string",
          "enum": ["off", "write", "all"],
          "default": "off",
          "markdownDescription": "Auth mode the local server boots with: `off` (nothing gated), `write` (write and PII tools need a credential), `all` (every tool call does)."
        }
      }
    }
  }
}
